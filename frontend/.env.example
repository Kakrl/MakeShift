# Server-only Supabase settings (#116). Do not commit real values.
# Real values live in Infisical (project "makeshift"); run the app with
#   infisical run --env=dev -- npm run dev
# which injects them without writing this file. See docs/supabase.md.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Uploads are refused on Vercel deployments (production and preview) unless this is 1,
# until upload rate limiting lands (#122).
RECORDING_UPLOADS=0

# Optional developer performance panel (requires rebuild); hidden by default.
NEXT_PUBLIC_PIPELINE_DIAGNOSTICS=0
